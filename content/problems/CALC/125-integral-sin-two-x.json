  "hint": "Let $u = 2x$, so $du = 2 \\, dx$ and $dx = \\frac{du}{2}$. The limits become $0$ and $\\pi$.",
  "hints": [
    {
      "level": "nudge",
      "text": "Let $u = 2x$, so $du = 2 \\, dx$ and $dx = \\frac{du}{2}$. The limits become $0$ and $\\pi$."
    },
    {
      "level": "guide",
      "text": "$\\frac{1}{2}\\int_0^{\\pi} \\sin u \\, du = \\frac{1}{2}[-\\cos u]_0^{\\pi}$."
    },
    {
      "level": "reveal",
      "text": "$\\frac{1}{2}\\left(-\\cos \\pi + \\cos 0\\right) = \\frac{1}{2}(1 + 1) = 1$."
