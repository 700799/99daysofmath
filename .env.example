# Firebase web config (optional). Without these, the app runs fully anonymously
# as "Math-Friend" — sign-in is simply not offered. Copy to .env.local for local
# dev, and set the same keys in Vercel → Project Settings → Environment Variables.
#
# Values come from Firebase console → Project settings → General → "Your apps"
# (Web app SDK config). Enable the Google sign-in provider under
# Authentication → Sign-in method, and add your domains (Vercel URL + localhost)
# under Authentication → Settings → Authorized domains.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
