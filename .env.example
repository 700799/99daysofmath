# ── Sign-in (Clerk) ──────────────────────────────────────────────────────────
# Optional. Without a key the app runs fully anonymously as "Math-Friend" and
# sign-in is simply not offered. Copy to .env.local for local dev, and set the
# same key in Vercel → Project Settings → Environment Variables (then redeploy:
# VITE_* values are baked in at build time).
#
# From the Clerk dashboard → API Keys → Publishable key (pk_test_… / pk_live_…).
# Add the site's domains (math10x.com, localhost) to the Clerk app, and enable
# whichever sign-in methods you want (Google, email code, …) under
# User & Authentication.
VITE_CLERK_PUBLISHABLE_KEY=

# ── Cloud progress sync (Firebase / Firestore) ──────────────────────────────
# Optional, and only meaningful with Clerk above. Progress is synced to
# Firestore at users/{clerkUserId}/state/progress. Firebase gets its session
# from Clerk: in the Clerk dashboard → Integrations → Firebase, upload the
# Firebase service account; that creates the `integration_firebase` JWT
# template the app asks for. Without it, sign-in still works and progress
# stays on the device.
#
# Values come from Firebase console → Project settings → General → "Your apps"
# (Web app SDK config). Firestore rules should allow
#   match /users/{uid}/{document=**} { allow read, write: if request.auth.uid == uid; }
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
